{
  "name": "loteria-mexicana",
  "version": "1.0.0",
  "description": "Cantor de Lotería Mexicana: baraja 54 cartas con voz en español (Web Speech API)",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:gh-pages": "ng build --configuration production",
    "deploy:gh-pages": "ng deploy --no-silent",
    "deploy": "npm run build:gh-pages && ng deploy --no-silent"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.3.5",
    "angular-cli-ghpages": "^3.1.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.7": true
  }
}
